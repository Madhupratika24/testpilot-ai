PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/testpilot

# A long random string used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string

# Google Gemini (https://aistudio.google.com/api-keys)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional backup model
GEMINI_FALLBACK_MODEL=

# GitHub OAuth App (GitHub > Settings > Developer settings > OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback
# Optional. Default is public_repo
GITHUB_SCOPE=public_repo
# 64 hex characters. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
GITHUB_TOKEN_KEY=